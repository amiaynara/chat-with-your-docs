DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/app
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=documents

# Real secrets (OPENAI_API_KEY, ANTHROPIC_API_KEY) belong in backend/.env, which is
# gitignored — never put a real key in this file, it's committed to git.

# EMBEDDING_PROVIDER=local avoids needing OPENAI_API_KEY/credits at all — see
# docs/embeddings.md. Cache location for the local model's weights (downloaded once
# from Hugging Face on first use), matched by the hf_cache volume in docker-compose.yml.
HF_HOME=/opt/hf-cache

# SECRET_MANAGER=local (default) reads backend/.secrets, which is gitignored — never
# put a real secret in this file. See docs/secrets.md.
SECRET_MANAGER=local
LOCAL_SECRETS_FILE=.secrets
