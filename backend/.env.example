DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/app
REDIS_URL=redis://localhost:6379/0

OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=documents

# Where the four *_API_KEY values just below actually come from — checked FIRST,
# ahead of the plain values in this file. "local" (default) reads backend/.secrets, a
# separate gitignored KEY=value file holding only those four keys — not this file, and
# not loaded by pydantic-settings the way everything else in .env is. "aws" reads AWS
# Secrets Manager instead (needs AWS credentials/an IAM role). See docs/secrets.md for
# the full .env-vs-.secrets comparison and exactly how the two sources combine.
SECRET_MANAGER=local
LOCAL_SECRETS_FILE=.secrets
AWS_SECRETS_REGION=us-east-1

# Fallback values for the four provider keys — only used when SECRET_MANAGER (above)
# has no value for that key, e.g. backend/.secrets doesn't set it. Either source works
# alone; set a key only here, or only in backend/.secrets/AWS Secrets Manager, or both
# (SECRET_MANAGER wins if both are set — see docs/secrets.md).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# "anthropic" (default, needs ANTHROPIC_API_KEY) or "google" (Gemini, needs
# GOOGLE_API_KEY — has a real free tier, rate-limited, not unconditionally free). See
# docs/llm-providers.md before switching. "anthropic" is the default purely to keep
# existing behavior unchanged, not a claim it's the better choice.
LLM_PROVIDER=anthropic
# Cheapest current Claude model — answering here is one stateless call per question (no
# tool use, no agent loop), so a larger/pricier model buys nothing here.
LLM_MODEL=claude-haiku-4-5-20251001
GOOGLE_LLM_MODEL=gemini-3.6-flash

# "local" (default, runs on-machine via sentence-transformers, no key/cost, roughly
# at parity on retrieval quality) or "openai" (hosted, needs OPENAI_API_KEY +
# credits). See docs/embeddings.md before switching — the two produce
# differently-sized vectors, so EMBEDDING_DIMENSIONS must be updated to match (the
# pgvector column is fixed-width — that also means a new migration to resize it),
# and existing documents re-ingested.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSIONS=384

LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL_VERSION=1

# Off by default — retrieval already runs hybrid vector+keyword search
# (issue #11) with no reranker required. Set true to insert a rerank step
# (vector→rerank→answer) via Cohere's hosted Rerank API; needs COHERE_API_KEY.
RERANKER_ENABLED=false
RERANKER_MODEL=rerank-v3.5
