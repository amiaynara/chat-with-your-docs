DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/app
REDIS_URL=redis://localhost:6379/0

OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=documents

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# "anthropic" (default, needs ANTHROPIC_API_KEY) or "google" (Gemini, needs
# GOOGLE_API_KEY — has a real free tier, rate-limited, not unconditionally free). See
# docs/llm-providers.md before switching. "anthropic" is the default purely to keep
# existing behavior unchanged, not a claim it's the better choice.
LLM_PROVIDER=anthropic
# Cheapest current Claude model — answering here is one stateless call per question (no
# tool use, no agent loop), so a larger/pricier model buys nothing here.
LLM_MODEL=claude-haiku-4-5-20251001
GOOGLE_LLM_MODEL=gemini-3.6-flash

# "openai" (default, needs OPENAI_API_KEY + credits) or "local" (runs on-machine via
# sentence-transformers, no key/cost, slightly lower retrieval quality). See
# docs/embeddings.md before switching — the two produce differently-sized vectors, so
# EMBEDDING_DIMENSIONS must be updated to match, and existing documents re-ingested.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSIONS=1536

LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL_VERSION=1
